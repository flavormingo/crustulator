---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

interface Props {
  light: ImageMetadata
  dark?: ImageMetadata
  alt: string
  eager?: boolean
}

const { light, dark, alt, eager = false } = Astro.props
const widths = [360, 540, 720, 900]
const sizes = '(min-width: 56rem) 22rem, 72vw'
const lightImage = await getImage({ src: light, widths, format: 'webp' })
const darkImage = dark ? await getImage({ src: dark, widths, format: 'webp' }) : null
---

<figure>
  <picture>
    {darkImage && <source media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} type="image/webp" />}
    <img
      src={lightImage.src}
      srcset={lightImage.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={light.width}
      height={light.height}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </picture>
</figure>
