---
import '@crustulator/brand/brand.css'
import '../styles/site.css'
import regular from '@crustulator/brand/fonts/HKGrotesk-Regular.woff2?url'
import wide from '@crustulator/brand/fonts/HKGroteskWide-ExtraBold.woff2?url'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'

interface Props {
  title: string
  description: string
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '')
const canonical = new URL(path.length > 1 ? path.replace(/\/$/, '') : '/', Astro.site)
const image = new URL('/og.png', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={wide} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={regular} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fff888" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2a0d0f" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crustulator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Crustulator logo, a pizza slice with ruler ticks, on butter yellow" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
